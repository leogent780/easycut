# Anthropic (Claude) API key — used for segment selection, hook titles, translation, card text, comment overlays
ANTHROPIC_API_KEY=

# Google OAuth client (Desktop app type) — shared across channels, from Google Cloud Console
YOUTUBE_OAUTH_CLIENT_SECRETS_FILE=config/youtube_client_secret.json

# Secrets backend: "keyring" (default, macOS Keychain / Windows Credential Manager) or "file" (encrypted-file fallback for headless Linux)
SECRETS_BACKEND=keyring
# Only used when SECRETS_BACKEND=file — passphrase to derive the Fernet encryption key. Keep this out of git.
SECRETS_FILE_PASSPHRASE=

# TTS provider plugin: "none" (captions only, no dubbing/narration), "gemini", or "elevenlabs"
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Gemini API key — used by viral_translate_dub (레퍼런스 영상 더빙): Gemini watches the
# uploaded reference video directly to write the transcript/script/hook-title, and (if
# TTS_PROVIDER=gemini) also generates the narration audio. Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Local paths
SHORTS_FACTORY_DATA_DIR=./data
